{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block header_title %}Dashboard{% endblock %}
{% block body %}
    <h1>Opening Hours</h1>
    <section>
        {% for message in app.flashes('notice') %}
            <div class="flash-notice">
                {{ message }}
            </div>
        {% endfor %}
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        
        {% set errors = form.openingHours.vars.errors %}
        {% if errors|length > 0 %}
            {{ errors|first.message }}
        {% endif %}
        <table>
            <thead>
                <tr>
                    <th>Day of week</th>
                    <th>Open time</th>
                    <th>Close time</th>
                    <th>Closed</th>
                </tr>
            </thead>
            <tbody>
                {% for openingHourField in form.openingHours %}
                    <tr>
                        <td>
                            {{ form_widget(openingHourField.dayOfWeek) }}</td>
                        <td>
                            {{ form_widget(openingHourField.openTime) }}</td>
                        <td>{{ form_widget(openingHourField.closeTime) }}</td>
                        <td>{{ form_widget(openingHourField.closedFlag) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <button type="submit">保存</button>
        {{ form_end(form)}}
        
           
    </section>
    <a href="{{ path('app_restaurant_detail', {'id': restaurant.id}) }}">Return</a>
    
    
    
    
        
{% endblock %}
