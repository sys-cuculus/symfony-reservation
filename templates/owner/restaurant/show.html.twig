{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block header_title %}Dashboard{% endblock %}
{% block body %}
    <h1>{{ restaurant.restaurantName }}</h1>
    <p>Address: {{ restaurant.address }}</p>
    <section>
        <h3>Opening hours</h3>
        <p>
            <table>
                <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            Open
                        </th>
                        <th>
                            Close
                        </th>
                        <th>
                            Closed
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for hours in openingHours %}
                        <tr>
                            <td>{{ hours.dayOfWeek.label() }}</td>
                            <td>{% if hours.openTime %}{{ hours.openTime|date('H:i') }}{% endif %}</td>
                            <td>{% if hours.closeTime %}{{ hours.closeTime|date('H:i') }}{% endif %}</td>
                            <td>{% if hours.closedFlag %}<input type="checkbox" checked disabled>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </p>
        <p><a class="button" href="{{ path('app_restaurant_opening_hours', {'id': restaurant.id})}}">Manage</a></p>
    </section>
    <section>
        <h3>Reservations</h3>
        <p>
            <table>
                <thead>
                    <tr>
                        <th>
                            Date and time
                        </th>
                        <th>
                            Number of people
                        </th>
                        <th>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td>{{ reservation.dateAndTime|date('d M Y H:i') }}</td>
                            <td>{{ reservation.numberOfPeople }}</td>
                            <td><a class="button" href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">Manage</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </p>
    </section>
    <section>
        <a 
            class="button"
            href="{{ path('app_restaurant_delete', {'id': restaurant.id}) }}"
            onclick="return confirm('Are you sure you want to delete this restaurant?')"
        >Delete restaurant</a>
    </section>
    
    
    
    
        
{% endblock %}
