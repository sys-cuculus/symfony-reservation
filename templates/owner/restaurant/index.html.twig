{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block header_title %}Dashboard{% endblock %}
{% block body %}
    {% for message in app.flashes('notice') %}
        <div class="flash-notice">
            {{ message }}
        </div>
    {% endfor %}
    <table>
        <thead>
            <tr>
                <th>
                    Restaurant
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for restaurant in restaurants %}
                <tr>
                    <td>{{ restaurant.restaurantName }}</td>
                    <td><a class="button" href="{{ path('app_restaurant_detail', {'id': restaurant.id})}}">Detail</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <p>
        <a class="button" href="{{ path('app_restaurant_new')}}">Add restaurant</a>
    </p>
    
{% endblock %}
