{% extends 'base.html.twig' %}

{% block title %}Reservations{% endblock %}

{% block body %}
    <h1>My Reservations</h1>

    <table>
        <thead>
            <tr>
                <th>Restaurant</th>
                <th>Date and Time</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>
                        <a href="{{ path('app_restaurant_show', {'id': reservation.restaurant.id}) }}">
                            {{ reservation.restaurant.restaurantName }}
                        </a>
                    </td>
                    <td>{{ reservation.dateAndTime|date('d-m-Y H:i') }}</td>
                    <td><a class="button" href="#">Manage</a></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">No reservations found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
