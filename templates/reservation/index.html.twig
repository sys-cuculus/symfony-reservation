{% extends 'base.html.twig' %}

{% block title %}Reservations{% endblock %}

{% block body %}
    <h1>My Reservations</h1>
    {% for message in app.flashes('notice') %}
        <div class="flash-notice">
            {{ message }}
        </div>
    {% endfor %}
    <table>
        <thead>
            <tr>
                <th>Restaurant</th>
                <th>Date and Time</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>
                        <a href="{{ path('app_restaurant_show', {'id': reservation.restaurant.id}) }}">
                            {{ reservation.restaurant.restaurantName }}
                        </a>
                    </td>
                    <td>{{ reservation.dateAndTime|date('d-m-Y H:i') }}</td>
                    <td>
                        <a 
                            class="button"
                            href="{{ path('app_reservation_edit', {'id': reservation.id}) }}"
                        >Manage</a>
                    </td>
                    <td>
                        <a 
                            class="button" 
                            href="{{ path('app_reservation_delete', {'id': reservation.id}) }}"
                            onclick="return confirm('Are you sure you want to cancel this reservation?');"
                        >Cancel</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">No reservations found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
